# ================================================================
# CoisaPet — Variáveis de ambiente
# ================================================================
# ATENÇÃO: Nunca suba o arquivo .env.local para o Git!
# Adicione .env.local no seu .gitignore.
#
# Como usar:
#   1. Copie este arquivo: cp .env.example .env.local
#   2. Preencha com as credenciais do seu projeto Supabase
#      Supabase → seu projeto → Settings → API
# ================================================================

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Integração Mercado Livre (supabase/fase16-ml-integracao.sql)
# client_id do app criado em developers.mercadolivre.com.br — não é
# secreto, pode ficar no front. O client_secret NUNCA vai aqui: ele é
# configurado só como secret da Edge Function (supabase secrets set
# ML_CLIENT_SECRET=...), junto com ML_CLIENT_ID e APP_ORDERS_URL.
VITE_ML_CLIENT_ID=
